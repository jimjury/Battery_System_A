# Template for an authorized independent C server. Never used by local tests.
persistence true
persistence_location /var/lib/mosquitto/
per_listener_settings false
allow_anonymous false
listener 8883
certfile /etc/ab-center/tls/fullchain.pem
keyfile /etc/ab-center/tls/privkey.pem
tls_version tlsv1.2
max_packet_size 8192
message_size_limit 8192
max_queued_messages 32
max_inflight_messages 8
# Resolve the library path on the actual server; do not guess/install locally.
plugin /usr/lib/x86_64-linux-gnu/mosquitto_dynamic_security.so
plugin_opt_config_file /var/lib/mosquitto/dynamic-security.json
